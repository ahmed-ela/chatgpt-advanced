{
  "manifest_version": 3,
  "name": "Threadlane",
  "description": "Highlight AI responses on ChatGPT, Claude, and Gemini, add inline notes, and queue follow-up messages in the native composer.",
  "icons": {
    "16": "assets/icons/16.png",
    "32": "assets/icons/32.png",
    "48": "assets/icons/48.png",
    "128": "assets/icons/128.png"
  },
  "options_page": "privacy.html",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "content.js",
        "queue-ui.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "queue-worker.js",
    "type": "module"
  }
}
