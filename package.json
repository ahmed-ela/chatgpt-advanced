{
  "name": "plannotator-chatgpt-notes",
  "private": true,
  "version": "0.3.3",
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "build:firefox": "bun run scripts/build.ts --target firefox",
    "dev": "bun run scripts/dev.ts",
    "test:dom": "bun test test/dom-compatibility.test.ts",
    "e2e": "bun run test/e2e.ts",
    "e2e:dev-reload": "bun run test/dev-reload.ts",
    "clean": "rm -rf dist",
    "test:queue": "bun test test/queue-store.test.ts",
    "reload": "bun run scripts/reload.ts",
    "version:check": "bun run scripts/version.ts check",
    "version:patch": "bun run scripts/version.ts patch",
    "version:minor": "bun run scripts/version.ts minor",
    "version:major": "bun run scripts/version.ts major",
    "package:release": "bun run scripts/package.ts",
    "package:firefox": "bun run scripts/package.ts --target firefox",
    "lint:firefox": "web-ext lint --source-dir dist-firefox --self-hosted",
    "test:release": "bun test test/release-package.test.ts",
    "build:chrome-beta": "bun run scripts/build.ts --target chrome-beta",
    "package:chrome-beta": "bun run scripts/package.ts --target chrome-beta",
    "feed:firefox": "bun run scripts/firefox-feed.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "puppeteer-core": "^24.8.0",
    "typescript": "^5.8.2",
    "web-ext": "10.7.0"
  },
  "dependencies": {
    "lucide": "1.51.0"
  }
}
